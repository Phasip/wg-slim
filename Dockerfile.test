FROM debian:latest

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV INITIAL_CONFIG="basic:\n  password: password\n  bind_addr: \"5000\"\nserver:\n  interface_name: wg0\n"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        make \
        default-jre-headless \
        nodejs \
        npm \
        docker-cli \
        wireguard-tools \
        nftables \
        chromium-driver \
        chromium \
        && rm -rf /var/lib/apt/lists/*


RUN npm install -g pyright

WORKDIR /app
COPY . /app

# Debian marks its python as externally managed; `make test` pip-installs the
# generated packages, so allow that for every pip call in this image.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN pip install --no-cache-dir -r requirements-dev.txt
RUN make openapi-clean
ENTRYPOINT ["make", "test"]
